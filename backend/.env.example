NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
DATABASE_PATH=./data/urban-cart.sqlite
FRONTEND_ORIGIN=http://localhost:5173
# Optional one-time bootstrap for the first admin (do not keep this password after provisioning).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-immediately
ADMIN_NAME=Urban Cart Admin
# Configure Stripe/Paymob adapter credentials here before enabling live card payments.
PAYMENT_PROVIDER=manual
PAYMENT_SECRET_KEY=
